<div class="relative flex min-h-full items-center justify-center bg-ink px-4 py-12 font-ui text-text antialiased">
  <button type="button" data-theme-toggle
    class="theme-btn absolute top-4 right-4 cursor-pointer rounded-lg border border-line px-3 py-1.5 text-sm text-muted transition hover:bg-raise hover:text-text">Theme</button>
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <h1 class="font-display text-5xl font-medium italic tracking-tight">Artscry</h1>
      <p class="mt-2 text-xs uppercase tracking-[0.2em] text-muted"><%= subtitle %></p>
    </div>
    <div class="rounded-2xl border border-line bg-panel p-7 shadow-xl shadow-black/10">
      <%= yield %>
    </div>
    <p class="mt-6 text-center text-sm text-muted"><%= footer %></p>
  </div>
</div>
