# Secrets are evaluated by Kamal at deploy time and passed to the containers.
# This file only holds references (env vars / commands), never secret values, so it is safe to commit.

# GitHub Container Registry token: a classic PAT with the write:packages scope.
# The same token as carnevale-backend works; export it before deploying.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails master key, read straight from the git-ignored file (never from the environment, so a
# RAILS_MASTER_KEY exported for another app cannot leak in).
RAILS_MASTER_KEY=$(cat config/master.key)
